# Vorlage für docker/.env (docker/.env steht in .gitignore und wird nie eingecheckt).
#   cp docker/.env.example docker/.env

# TRUE bedeutet: Du akzeptierst die Minecraft-EULA (https://aka.ms/MinecraftEULA).
# Ohne TRUE starten die Paper-Server nicht.
MINECRAFT_EULA=FALSE

# Gemeinsames Geheimnis für Velocity "modern forwarding" (Proxy <-> Paper).
# Zufällig erzeugen, z. B.: openssl rand -hex 24
VELOCITY_SECRET=

# Passwort des Datenbanknutzers "network" (nur lokal).
POSTGRES_PASSWORD=

# Nick-Pool (Spec 01 §6.11, /nickpool fill): Quell-UUIDs für Mojang-signierte Skins (Sessionserver,
# ?unsigned=false), durch Komma getrennt. Nur Profile verwenden, deren Skins ihr nutzen dürft.
NETWORK_NICK_SKIN_UUIDS=
# Erzeugte Namen bei der Mojang-Namens-API prüfen (true/false) und Abstand der Anfragen in ms.
NETWORK_NICK_CHECK_MOJANG=true
NETWORK_NICK_MOJANG_INTERVAL_MS=1100
# Optional: MineSkin als zweite Skin-Quelle. Schlüssel geheim halten (nie einchecken).
NETWORK_MINESKIN_KEY=
NETWORK_NICK_MINESKIN_IDS=
# Optional: zusätzliche gesperrte Wörter für Nicknamen, durch Komma getrennt.
NETWORK_NICK_BLOCKED_WORDS=
