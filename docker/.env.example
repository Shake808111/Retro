# Vorlage für docker/.env (docker/.env steht in .gitignore und wird nie eingecheckt).
#   cp docker/.env.example docker/.env

# TRUE bedeutet: Du akzeptierst die Minecraft-EULA (https://aka.ms/MinecraftEULA).
# Ohne TRUE starten die Paper-Server nicht.
MINECRAFT_EULA=FALSE

# Gemeinsames Geheimnis für Velocity "modern forwarding" (Proxy <-> Paper).
# Zufällig erzeugen, z. B.: openssl rand -hex 24
VELOCITY_SECRET=

# Passwort des Datenbanknutzers "network" (nur lokal).
POSTGRES_PASSWORD=
